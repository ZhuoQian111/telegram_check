# Generate secrets locally; never commit the filled .env.
ADMIN_PASSWORD=replace-with-at-least-10-characters
SESSION_ENCRYPTION_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional for the first deploy; defaults to http://localhost:3000 when empty.
# After deployment, set the actual public HTTPS origin before logging in online.
APP_ORIGIN=
DATABASE_PATH=./data/app.sqlite
SCHEDULER_ENABLED=false
